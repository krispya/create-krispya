{
  "name": "create-krispya",
  "version": "0.9.0",
  "description": "🌹 CLI for creating web projects with (my) sensible defaults",
  "keywords": [
    "cli",
    "r3f",
    "react",
    "react-three-fiber",
    "scaffold",
    "vite"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "create-krispya": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "unbuild",
    "release": "pnpm run build && pnpm publish",
    "test": "vitest",
    "lint": "oxlint -c .config/oxlint.json",
    "format": "prettier --config .config/prettier.json --ignore-path .config/prettierignore --write .",
    "typecheck": "tsc --build --noEmit",
    "typecheck:watch": "tsc --build --watch"
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "conf": "^13.0.0",
    "ora": "^8.2.0",
    "undici": "^5.28.4"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "oxlint": "^1.51.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "unbuild": "^3.5.0",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "pnpm": ">=10.0.0",
    "node": ">=25.0.0"
  }
}
